{
  "executable": "SignageAdmin.Web",
  "splashscreen": {
    "imageFile": ""
  },
  "name": "signage-beheer",
  "author": "Vhishal Tewari",
  "singleInstance": true,
  "aspCoreBackendPort": 8001,
  "environment": "Production",
  "build": {
    "appId": "nl.reliplan.signagebeheer",
    "productName": "Signage Beheer",
    "copyright": "Copyright \u00a9 2026 Vhishal Tewari",
    "buildVersion": "1.0.0",
    "win": {
      "icon": "bin/Properties/AppIcon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "compression": "maximum",
    "directories": {
      "output": "../../../bin/Desktop"
    },
    "extraResources": [
      {
        "from": "./bin",
        "to": "bin",
        "filter": [
          "**/*",
          "!wwwroot/data/**",
          "!wwwroot/uploads/**",
          "!*.development-root"
        ]
      }
    ],
    "files": [
      "**/*",
      "!bin/**"
    ],
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false,
      "installerIcon": "bin/Properties/AppIcon.ico",
      "uninstallerIcon": "bin/Properties/AppIcon.ico",
      "installerHeaderIcon": "bin/Properties/AppIcon.ico"
    }
  }
}
